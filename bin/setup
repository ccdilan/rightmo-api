#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
if [ ! -f .env.docker ]; then
    cp .env.docker.example .env.docker
fi
if ! grep -q '^APP_KEY=base64:' .env.docker; then
    task_app_key=$(openssl rand -base64 32)
    task_env_tmp=$(mktemp)
    sed "s|^APP_KEY=.*|APP_KEY=base64:$task_app_key|" .env.docker > "$task_env_tmp"
    mv "$task_env_tmp" .env.docker
fi
chmod 600 .env.docker
docker compose up --build --wait --wait-timeout 180
docker compose exec -T app php artisan migrate --force --no-interaction
printf '%s\n' 'Rightmo is ready at http://localhost:3000' 'Seed demo data explicitly: docker compose exec app php artisan db:seed --class=DemoSeeder --no-interaction'
