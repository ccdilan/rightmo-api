#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
docker compose exec -T -e APP_ENV=testing -e DB_DATABASE=rightmo_testing -e DB_HOST=mysql -e DB_PORT=3306 -e DB_USERNAME=rightmo -e DB_PASSWORD=rightmo_local -e CACHE_STORE=array -e SESSION_DRIVER=array -e LOG_CHANNEL=single app php -d pcov.enabled=1 vendor/bin/pest --compact "$@"
